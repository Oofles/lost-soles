# Copy to .env.local and fill in. NEVER put real values in this file —
# it is the one env file that IS committed (docs/08-security-privacy.md §7.2).
#
# In deployed environments these live in SSM via Amplify's secret(), not in a
# file. This example exists so a new machine knows what is required.

# ─── Strava (docs/03-integrations.md §2) ───────────────────────────────────
STRAVA_CLIENT_ID=00000
STRAVA_CLIENT_SECRET=replace-me
# Echoed back during the webhook subscription handshake. Any random string.
STRAVA_WEBHOOK_VERIFY_TOKEN=replace-me

# ─── Basemap tiles (docs/05-map-and-fog.md, ticket 0052) ───────────────────
# NOT A SECRET, and deliberately not a secret() — an ordinary environment
# variable (docs/01-architecture.md §7). It is a public URL: the browser fetches
# tiles from it directly, so it is in the client bundle by necessity and there is
# nothing to protect. It is listed in the §7 registry only because it VARIES BY
# ENVIRONMENT, which is a different problem from being sensitive.
#
# The standing rule that makes this distinction matter: environment variables are
# NOT secrets. Amplify renders them in plaintext into build artifacts, readable by
# anyone with `get-app` on the app. Anything sensitive uses secret().
NEXT_PUBLIC_TILES_BASE_URL=https://tiles.example.invalid

# ─── Ingest endpoint (docs/03-integrations.md §4.2) ────────────────────────
# Bearer token GPSLogger and any file-upload client present.
INGEST_BEARER_TOKEN=replace-me

# ─── Tickets (docs/07-ticketsmith.md §6) ───────────────────────────────────
# Fine-grained PAT, single repo, Contents: read/write ONLY.
GITHUB_TICKETS_PAT=replace-me
GITHUB_WEBHOOK_SECRET=replace-me

# ─── AWS ───────────────────────────────────────────────────────────────────
# Local dev only. Never a key — a PROFILE NAME. Credentials live in ~/.aws.
AWS_PROFILE=devault
AWS_REGION=us-east-1
