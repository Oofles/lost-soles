#!/usr/bin/env bash
# Pre-commit secret scan. docs/08-security-privacy.md §7.3 layer 1.
#
# This is the layer that makes an accidental `git add .` survivable, and it is
# the direct answer to the O-005 finding. It runs on STAGED CONTENT only.
#
# ONE RULE GOVERNS EVERY CHECK BELOW (ticket 0137): a guard must be able to tell
# "I ran and found nothing" from "I never ran". Those two states are the same
# value in shell far more often than they look — an empty string, an exit 0 —
# and every time they have been conflated in this file it has failed OPEN.
set -uo pipefail

fail() { echo "" >&2; echo "  COMMIT BLOCKED: $*" >&2; echo "" >&2; exit 1; }

# ── 1. gitleaks on staged content ──────────────────────────────────────────
if command -v gitleaks >/dev/null 2>&1; then
  # `command -v` answers "is there a FILE on PATH called gitleaks", not "is there
  # a WORKING secret scanner". Those came apart on 2026-09-01 (ticket 0137 §1b):
  # the real binary was overwritten with a 19-byte `#!/bin/bash` / `exit 0` stub,
  # and every commit for the rest of that session passed this layer in complete
  # silence. A present-but-broken scanner is the more dangerous of the two cases —
  # a MISSING gitleaks blocks loudly at the `else` below, a BROKEN one waves
  # everything through. So make it prove liveness before trusting its verdict.
  #
  # `[[ =~ ]]` is a bash BUILTIN on purpose. Piping to grep here would make the
  # liveness check itself depend on a second external tool — and a missing grep
  # would then be reported as a broken gitleaks, which is the same "cannot tell
  # which control failed" problem one level up. Caught while re-running this
  # ticket's own reproduction, whose stub PATH had no grep on it.
  gl_version=$(gitleaks version 2>/dev/null) || gl_version=""
  if [[ ! $gl_version =~ [0-9]+\.[0-9]+ ]]; then
    fail "gitleaks is on PATH but does not work — it is a broken guard, not a scanner.
  'gitleaks version' should print something like 8.28.0. It printed: '${gl_version}'
  Reinstall it (https://github.com/gitleaks/gitleaks/releases). Nothing has been
  committed. If you have genuinely considered the risk: git commit --no-verify"
  fi
  if ! gitleaks protect --staged --redact --no-banner; then
    fail "gitleaks found a secret in staged content (above, redacted).
  Nothing has been committed. Unstage it, remove the secret, and try again.
  A credential value never belongs in a file — use ~/.aws, SSM, or an env var."
  fi
else
  # Never pass silently. A missing scanner is a broken guard, not an absent one.
  fail "gitleaks is not installed, so staged content cannot be scanned.
  Install it (https://github.com/gitleaks/gitleaks/releases) or, if you have
  genuinely considered the risk, bypass this once with: git commit --no-verify"
fi

# ── 2. literal patterns, belt-and-braces ───────────────────────────────────
# Explicit patterns from §7.3. Cheap, and independent of gitleaks' ruleset.
PATTERNS=(
  'AKIA[0-9A-Z]{16}'
  'ghp_[A-Za-z0-9]{36}'
  'github_pat_[A-Za-z0-9_]{20,}'
  '-----BEGIN [A-Z ]*PRIVATE KEY-----'
  'xox[baprs]-[A-Za-z0-9-]+'
)
# CHECK THE EXIT STATUS, not just the output (ticket 0137 §1). `staged=$(git ...)`
# discards it, and a git that CANNOT ANSWER then produces a byte-identical result
# to a staging area that is EMPTY: the empty string. This hook treated both as
# "nothing to scan" and exited 0, skipping layers 2 and 3 in silence. `git diff`
# failing is routine — dubious repository ownership (containers, shared volumes,
# sudo), a corrupt index, a missing safe.directory entry, an unreadable HOME.
#
# stderr is merged into $staged on purpose, so the block message can quote git's
# own words. On success this command prints nothing on stderr; if some future git
# did emit a warning it would be treated as a filename, which layer 2 skips via
# `[ -f ]` and layer 3 could at worst over-trigger on — both fail CLOSED.
if ! staged=$(git diff --cached --name-only --diff-filter=ACM 2>&1); then
  fail "git could not list the staged files, so the checks below never ran.
  git said:
    ${staged}

  This is a broken guard, not a clean scan — the same reasoning applied to a
  missing gitleaks above. Fix git (often: git config --global --add
  safe.directory \"\$PWD\") and commit again. Nothing has been committed."
fi
# Nothing staged is not a pass to hurry through — it is simply nothing to scan,
# and it is now distinguishable from the failure handled directly above.
#
# NOTE: a bare `[ -z "$staged" ] && exit 0` here is what broke this hook once
# (ticket 0125). A scripted edit replaced the FIRST `exit 0` in the file, which
# was this one, and in doing so swallowed the next check into the && and left
# everything below an unconditional exit. Written as an explicit `if` block so
# there is no bare `exit 0` mid-file for an edit to land on, and so the early
# return cannot silently absorb whatever gets added after it.
if [ -z "$staged" ]; then
  exit 0
fi

hits=""
while IFS= read -r f; do
  [ -f "$f" ] || continue
  for p in "${PATTERNS[@]}"; do
    # NOTE the `--`: without it, grep parses a pattern beginning "-----BEGIN"
    # as command-line options and errors out, silently skipping that check.
    #
    # Lines carrying `gitleaks:allow` are exempt — gitleaks' own convention,
    # reused here so both layers honour one marker. This project's security
    # docs necessarily quote credential patterns in order to document them,
    # and a scanner that cannot tell documentation from a secret gets disabled
    # by whoever it blocks at 11pm. Deny by default, allow by VISIBLE exception:
    # the marker sits on the line, in the diff, where a reviewer sees it.
    #
    # NOT `grep -q` (ticket 0137). `-q` exits at the FIRST match, which SIGPIPEs
    # whatever is still writing into it, and `set -o pipefail` then reports 141
    # for the whole pipeline — so the `if` reads FALSE having actually MATCHED,
    # and the hit is discarded in silence. Demonstrated:
    #     set -o pipefail; big=$(seq 1 200000); echo "$big" | grep -q '^1$'
    # returns 141. Plain `grep -E >/dev/null` consumes all of its input, so
    # nothing upstream is ever SIGPIPEd and PIPESTATUS means what it says.
    #
    # `-a` ON BOTH GREPS, and the reason it must be both is the whole of ticket
    # 0148. A single NUL byte anywhere in the file puts GNU grep into binary
    # mode, where it writes "binary file matches" to STDERR and the matching
    # lines NOWHERE. The FIRST grep is where the content is therefore lost: the
    # second grep reads an empty stream and exits 1, and this hook reads that
    # as "scanned, clean". Verified on GNU grep 3.7 with an AKIA-shaped key:
    #
    #   -a on NEITHER  -> PIPESTATUS[2]=1   the key is NOT detected
    #   -a on SECOND   -> PIPESTATUS[2]=1   STILL not detected  <-- the trap
    #   -a on BOTH     -> PIPESTATUS[2]=0   detected
    #
    # The one-character fix that looks right is the middle line, which is why
    # it is spelled out here rather than left to whoever next tidies this up.
    # It is D-176's failure class again — "I never ran" wearing "I ran and
    # found nothing" — and ticket 0018 records a real day on which it fired:
    # NULs in a fixture disabled this layer while gitleaks passed token-shaped
    # strings in that same file. Both layers off, nobody aware.
    git show ":$f" 2>/dev/null | grep -a -vF 'gitleaks:allow' | grep -a -E -- "$p" >/dev/null
    st=("${PIPESTATUS[@]}")
    # git failing to read a file it just told us is staged is a broken guard, not
    # a clean scan (D-176). `2>/dev/null` used to hide exactly that.
    [ "${st[0]}" -eq 0 ] || fail "git could not read the staged content of '${f}',
  so that file was never scanned. Nothing has been committed."
    if [ "${st[2]}" -eq 0 ]; then
      hits="${hits}
    ${f}  matches  ${p}"
    fi
  done
done <<< "$staged"

if [ -n "$hits" ]; then
  fail "staged content matches a known credential pattern:${hits}

  Nothing has been committed."
fi

# ── 3. skill frontmatter ───────────────────────────────────────────────────
# A SKILL.md whose frontmatter does not parse is skipped by Claude Code with no
# error shown anywhere (ticket 0123). Cheap to check, invisible to debug.
#
# check-skills.mjs no longer exits 0 when it cannot find .claude/skills (0137):
# reaching here means a SKILL.md is STAGED, so an absent skills directory would
# mean the scanner resolved the wrong root, not that there is nothing to check.
#
# THE GATE IS PURE BASH — no pipeline, no subprocess (ticket 0137, defect 2).
# It used to be `echo "$staged" | grep -q 'SKILL\.md$'`, and in the Amplify build
# container that returned FALSE with a non-empty $staged that DID contain a
# SKILL.md line. The build log proves it: the failing run spent the full layer-2
# cost on three files (149ms, more than the 144ms two-file negative control) and
# then ran check-skills.mjs zero times, while the very same suite passed the
# same check twice on two-file repos moments earlier.
#
# A two-process pipeline can answer "false" for reasons that have nothing to do
# with the string: `pipefail` turning a SIGPIPEd writer into 141 after a
# successful match, a fork that could not be taken, a grep that could not exec.
# All three are "I never ran" wearing "I ran and found nothing" — D-176 — and
# `case` in a builtin loop removes every one of them at once, because it depends
# on nothing but $staged.
skill_staged=0
while IFS= read -r f; do
  case "$f" in *SKILL.md) skill_staged=1; break ;; esac
done <<< "$staged"

if [ "$skill_staged" -eq 1 ]; then
  if [ -f scripts/check-skills.mjs ] && ! node scripts/check-skills.mjs >/dev/null 2>&1; then
    node scripts/check-skills.mjs >&2 || true
    fail "a staged SKILL.md has unparseable frontmatter — Claude Code would skip it silently."
  fi
fi

# The ONLY exit 0 in this file that is not inside an explicit if-block, and it is
# the last line. scripts/pre-commit-hook.test.mjs asserts that stays true.
exit 0
